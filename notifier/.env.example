# Server-side only. This directory is the ONLY place the service_role key belongs.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SMTP. Mailtrap sandbox is recommended for demos — it captures mail in a
# web inbox instead of delivering to real people.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM="Shadow AI Guard <alerts@shadowaiguard.demo>"

# How often to check for critical events, in minutes.
NOTIFIER_INTERVAL_MINUTES=2

# Set to 1 to print emails to the console instead of sending them.
# Useful for a demo with no SMTP account configured.
DRY_RUN=0
